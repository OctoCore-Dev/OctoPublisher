<Project>
  <Import Project="$(MSBuildThisFileDirectory)version.props" Condition="Exists('$(MSBuildThisFileDirectory)version.props')" />
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.local" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.local')" />
  <PropertyGroup>
    <IsWindows Condition="'$([MSBuild]::IsOSPlatform(&quot;Windows&quot;))' == 'true' or '$(OS)' == 'Windows_NT'">true</IsWindows>
    <WorkspaceCodeRoot Condition="'$(IsWindows)' == 'true'">$([System.IO.Path]::GetFullPath('$(USERPROFILE)/code/').Replace('\', '/'))</WorkspaceCodeRoot>
    <WorkspaceCodeRoot Condition="'$(IsWindows)' != 'true' and Exists('/mnt/c/Users/irovb/code/')">/mnt/c/Users/irovb/code/</WorkspaceCodeRoot>
    <WorkspaceCodeRoot Condition="'$(WorkspaceCodeRoot)' == '' and '$(HOME)' != ''">$(HOME)/code/</WorkspaceCodeRoot>

    <NormalizedProjectDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/').Replace('\', '/'))</NormalizedProjectDir>
    <ProjectCacheSubDir Condition="'$(WorkspaceCodeRoot)' != '' and $([System.String]::Copy('$(NormalizedProjectDir)').StartsWith('$(WorkspaceCodeRoot)'))">$([System.String]::Copy('$(NormalizedProjectDir)').Substring('$([System.String]::Copy('$(WorkspaceCodeRoot)').Length)'))</ProjectCacheSubDir>
    <ProjectCacheSubDir Condition="'$(ProjectCacheSubDir)' == ''">$(MSBuildProjectName)</ProjectCacheSubDir>
    <CustomCachePath Condition="'$(BUILD_CACHE_PATH)' != ''">$(BUILD_CACHE_PATH)/$(ProjectCacheSubDir)</CustomCachePath>
    <CustomCachePath Condition="'$(CustomCachePath)' == '' and '$(IsWindows)' == 'true'">C:/BuildCache/$(ProjectCacheSubDir)</CustomCachePath>
    <CustomCachePath Condition="'$(IsWindows)' != 'true' and '$(HOME)' != ''">$(HOME)/.cache/build/$(ProjectCacheSubDir)</CustomCachePath>
    <CustomCachePath Condition="'$(CustomCachePath)' == ''">$(MSBuildProjectDirectory)/.artifacts</CustomCachePath>
    <PackageRoot Condition="'$(IsWindows)' == 'true'">$(USERPROFILE)/Documents/Package/</PackageRoot>
    <PackageRoot Condition="'$(IsWindows)' != 'true' and Exists('/mnt/c/Users/irovb/Documents/Package/')">/mnt/c/Users/irovb/Documents/Package/</PackageRoot>
    <PackageRoot Condition="'$(PackageRoot)' == '' and '$(HOME)' != ''">$(HOME)/Package/</PackageRoot>
    <PackageRoot Condition="'$(PackageRoot)' == ''">$(MSBuildProjectDirectory)/Package/</PackageRoot>
  </PropertyGroup>

  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(CustomCachePath)</ArtifactsPath>
    <BaseOutputPath>$(CustomCachePath)/bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(CustomCachePath)/obj/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(CustomCachePath)/obj/</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Features>strict</Features>
    <WarningLevel>9999</WarningLevel>
    <Version Condition="'$(Version)' == ''">$(AppVersion)</Version>
    <IsTrimmable Condition="'$(PublishAot)' == 'true' or '$(PublishTrimmed)' == 'true'">true</IsTrimmable>
    <EnableTrimAnalyzer Condition="'$(PublishAot)' == 'true' or '$(PublishTrimmed)' == 'true'">true</EnableTrimAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault Condition="'$(PublishAot)' != 'true' and '$(PublishTrimmed)' != 'true'">true</JsonSerializerIsReflectionEnabledByDefault>
    <JsonSerializerIsReflectionEnabledByDefault Condition="'$(PublishAot)' == 'true' or '$(PublishTrimmed)' == 'true'">false</JsonSerializerIsReflectionEnabledByDefault>
    <GITHUB_ACTIONS Condition="'$(GITHUB_ACTIONS)' == ''">false</GITHUB_ACTIONS>
    <PackageMode Condition="'$(PackageMode)' == ''">MSIX</PackageMode>
    <NoWarn>$(NoWarn);SigningCertificateNoCertSpecified;</NoWarn>
    <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
  </PropertyGroup>

  <PropertyGroup>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <Deterministic>true</Deterministic>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>high</NuGetAuditLevel>
  </PropertyGroup>

  <Target Name="EnsureBuildCacheDir" BeforeTargets="BeforeBuild;Restore" Condition="'$(IsWindows)' == 'true' and !Exists('C:\BuildCache')">
    <MakeDir Directories="C:\BuildCache" ContinueOnError="true" />
  </Target>

  <Target Name="SyncSharedConfigFiles" BeforeTargets="BeforeBuild" Condition="'$(IsWindows)' == 'true' and Exists('$(USERPROFILE)\code\sync_configs.ps1')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(USERPROFILE)\code\sync_configs.ps1&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot;" IgnoreExitCode="true" />
  </Target>
</Project>
