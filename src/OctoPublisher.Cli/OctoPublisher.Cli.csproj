<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>OctoPublisher.Cli</RootNamespace>
    <AssemblyName>octopublish</AssemblyName>
    
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>octopublish</ToolCommandName>
    <PackageId>OctoPublisher</PackageId>
    <Description>High-performance universal multi-store publishing CLI for modern CI/CD and local terminals.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://nuget.octopublisher.octocore.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/OctoCore-Dev/OctoPublisher</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>microsoft-store;msstore;windows;packaging;msix;ci-cd;google-play</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Octo.Common\Octo.Common.csproj" />
    <ProjectReference Include="..\Octo.MStore\Octo.MStore.csproj" />
    <ProjectReference Include="..\Octo.PlayStore\Octo.PlayStore.csproj" />
  </ItemGroup>
</Project>
